# Environment and secrets (commit .env.example only)
.env
.env.*
!.env.example
*.key
auth.json

# Dependencies
/vendor/
/node_modules/

# Local databases
/database/*.sqlite
/database/*.sqlite-journal
*.sqlite

# Storage: logs, compiled files, caches, sessions
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/*.key
/bootstrap/cache/*.php

# Uploaded media and public storage link
/storage/app/public/*
/storage/app/private/*
/storage/app/livewire-tmp/
/public/storage
/public/media/

# Built assets
/public/build/
/public/css/filament
/public/hot
/public/js/filament

# Local-only agent memory (back it up manually)
/CLAUDE.md

# Source material (yours, never committed)
/content/inbox/
/content/staged/

